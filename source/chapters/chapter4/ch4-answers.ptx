<?xml version="1.0" encoding="UTF-8"?>

<!-- Chapter 4 answers.

     Structure: an <exercises> division, so every level is a dropdown.
       exercise  -> dropdown (publication knowl/@exercise-divisional="yes")
       task      -> dropdown (publication knowl/@task="yes")
       solution  -> dropdown (always born hidden in PreTeXt)

     Exercise numbering restarts inside each <exercises> division, so the
     numbers here line up with ch4-exercises.ptx automatically. Keep the
     order of <exercise> elements identical to that file.
  -->

<exercises xml:id="ch4-answers" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Answers to Ch. 4 Exercises</title>

  <introduction>
    <p>
      Answers to the exercises of this chapter. Click an
      exercise to open it, click a part to open that part, then click
      <term>Solution</term> to reveal the answer.
    </p>
    <p>
      These are the answers to the questions, not fully worked solutions. Enough is shown that you can
      tell whether your own work got to the correct conclusion.
    </p>
  </introduction>

  <!-- ============================================================ -->
  <exercise xml:id="ans-hw-types-a-b">
    <title>Two Types of Interaction</title>

    <task xml:id="ans-types-a-b-p1-words">
      <title>Player 1's strategy <m>DU</m></title>
      <statement>
        <p>
          Describe Player 1's strategy <m>DU</m> in words.
        </p>
      </statement>
      <solution>
        <p>
          Player 1 moves down if the type is <m>A</m> and up if the type
          is <m>B</m>.
        </p>
      </solution>
    </task>

    <task xml:id="ans-types-a-b-p2-words">
      <title>Player 2's strategy <m>LR</m></title>
      <statement>
        <p>
          Describe Player 2's strategy <m>LR</m> in words.
        </p>
      </statement>
      <solution>
        <p>
          Player 2 moves left if Player 1 moved up and right if Player 1
          moved down.
        </p>
      </solution>
    </task>

    <task xml:id="ans-types-a-b-profile">
      <title>Payoffs for <m>(DU, LR)</m></title>
      <statement>
        <p>
          What are the payoffs for <m>(DU, LR)</m> when the interaction is
          of type <m>A</m>? Of type <m>B</m>? What is the expected payoff
          to each player?
        </p>
      </statement>
      <solution>
        <ul>
          <li>
            <p>
              Type <m>A</m>: <m>(1, 1)</m>.
            </p>
          </li>
          <li>
            <p>
              Type <m>B</m>: <m>(6, 4)</m>.
            </p>
          </li>
          <li>
            <p>
              Expected payoffs:
              <m>\frac{3}{4}(1, 1) + \frac{1}{4}(6, 4) = \left(\frac{9}{4}, \frac{7}{4}\right)</m>.
            </p>
          </li>
        </ul>
      </solution>
    </task>

    <task xml:id="ans-types-a-b-normal-form">
      <title>The Bayesian normal form</title>
      <statement>
        <p>
          Construct the Bayesian normal form of this game.
        </p>
      </statement>
      <solution>
        <tabular row-headers="yes" halign="center" top="minor" bottom="minor" left="minor" right="minor">
          <col halign="left" right="minor" />
          <col right="minor" />
          <col right="minor" />
          <col right="minor" />
          <col />
          <row header="yes" bottom="minor">
            <cell></cell>
            <cell>Player 2: <m>LL</m></cell>
            <cell>Player 2: <m>LR</m></cell>
            <cell>Player 2: <m>RL</m></cell>
            <cell>Player 2: <m>RR</m></cell>
          </row>
          <row bottom="minor">
            <cell>Player 1: <m>UU</m></cell>
            <cell><m>\left(\frac{9}{2}, 4\right)</m></cell>
            <cell><m>\left(\frac{9}{2}, 4\right)</m></cell>
            <cell><m>\left(0, \frac{15}{4}\right)</m></cell>
            <cell><m>\left(0, \frac{15}{4}\right)</m></cell>
          </row>
          <row bottom="minor">
            <cell>Player 1: <m>UD</m></cell>
            <cell><m>(3, 3)</m></cell>
            <cell><m>\left(4, \frac{9}{2}\right)</m></cell>
            <cell><m>\left(0, \frac{15}{4}\right)</m></cell>
            <cell><m>\left(1, \frac{21}{4}\right)</m></cell>
          </row>
          <row bottom="minor">
            <cell>Player 1: <m>DU</m></cell>
            <cell><m>\left(\frac{21}{4}, 1\right)</m></cell>
            <cell><m>\left(\frac{9}{4}, \frac{7}{4}\right)</m></cell>
            <cell><m>\left(\frac{15}{4}, 0\right)</m></cell>
            <cell><m>\left(\frac{3}{4}, \frac{3}{4}\right)</m></cell>
          </row>
          <row>
            <cell>Player 1: <m>DD</m></cell>
            <cell><m>\left(\frac{15}{4}, 0\right)</m></cell>
            <cell><m>\left(\frac{7}{4}, \frac{9}{4}\right)</m></cell>
            <cell><m>\left(\frac{15}{4}, 0\right)</m></cell>
            <cell><m>\left(\frac{7}{4}, \frac{9}{4}\right)</m></cell>
          </row>
        </tabular>
      </solution>
    </task>

    <task xml:id="ans-types-a-b-equilibria">
      <title>Bayesian Nash equilibria</title>
      <statement>
        <p>
          Find all Bayesian Nash equilibria of the game.
        </p>
      </statement>
      <solution>
        <p>
          <m>(UU, LR)</m> and <m>(DD, RR)</m>.
        </p>
      </solution>
    </task>
  </exercise>

  <!-- ============================================================ -->
  <exercise xml:id="ans-hw-beliefs-expected-payoff">
    <title>Beliefs and Expected Payoffs</title>

    <task xml:id="ans-beliefs-player1">
      <title>Player 1's expected payoffs</title>
      <statement>
        <p>
          Compute <m>\pi_1(x, \theta_2)</m> and <m>\pi_1(y, \theta_2)</m>.
        </p>
      </statement>
      <solution>
        <p>
          <m>\pi_1(x, \theta_2) = \frac{30}{7}</m> and
          <m>\pi_1(y, \theta_2) = \frac{27}{7}</m>.
        </p>
      </solution>
    </task>

    <task xml:id="ans-beliefs-player2">
      <title>Player 2's expected payoffs</title>
      <statement>
        <p>
          Compute <m>\pi_2(\theta_1, a)</m>, <m>\pi_2(\theta_1, b)</m>, and
          <m>\pi_2(\theta_1, c)</m>.
        </p>
      </statement>
      <solution>
        <p>
          <m>\pi_2(\theta_1, a) = \frac{10}{3}</m>,
          <m>\pi_2(\theta_1, b) = 1</m>, and
          <m>\pi_2(\theta_1, c) = \frac{10}{3}</m>.
        </p>
      </solution>
    </task>

    <task xml:id="ans-beliefs-best-response">
      <title>Best responses to beliefs</title>
      <statement>
        <p>
          Find Player 1's best response(s) to <m>\theta_2</m> and Player
          2's best response(s) to <m>\theta_1</m>.
        </p>
      </statement>
      <solution>
        <ul>
          <li>
            <p>
              Player 1's best response to <m>\theta_2</m> is <m>x</m>.
            </p>
          </li>
          <li>
            <p>
              Player 2 has two best responses to <m>\theta_1</m>:
              <m>a</m> and <m>c</m>.
            </p>
          </li>
        </ul>
      </solution>
    </task>
  </exercise>

  <!-- ============================================================ -->
  <exercise xml:id="ans-hw-simple-poker">
    <title>A Simple Poker Game</title>

    <task xml:id="ans-simple-poker-tree">
      <title>The extensive form</title>
      <statement>
        <p>
          Draw the game in extensive form.
        </p>
      </statement>
      <solution>
        <figure xml:id="fig-ans-simple-poker">
          <caption>
            The simple poker game, with Player 1's payoff listed first.
            The dashed line is Player 2's information set.
          </caption>
          <image width="85%">
            <shortdescription>
              Game tree with Nature dealing a card, then Player 1, then
              Player 2, with one information set for Player 2.
            </shortdescription>
            <description>
              <p>
                A node labeled N for Nature has two branches: high card
                with probability one half, and low card with probability
                one half. Each leads to a node for Player 1, with branches
                F and B. Folding gives payoffs negative 2 and 2. Bidding
                leads to a node for Player 2, and a dashed line joins
                Player 2's two nodes.
              </p>
              <p>
                After the high card and a bid, Player 2 bidding gives 4
                and negative 4, and folding gives 2 and negative 2. After
                the low card and a bid, Player 2 bidding gives negative 4
                and 4, and folding gives 2 and negative 2. Player 1's
                payoff is listed first.
              </p>
            </description>
            <latex-image>
              \resizebox{13cm}{!}{%
              \begin{tikzpicture}[
                font=\scriptsize,
                nd/.style={circle,fill=black,inner sep=1.3pt}
              ]
              \useasboundingbox (-7.6,0.0) rectangle (7.6,6.4);

              % Nature
              \node[nd] (N) at (0,5.6) {};
              \node[above=3pt of N] {$N$};

              % Player 1 nodes
              \node[nd] (P1) at (-4,4) {};
              \node[above left=1pt and 2pt of P1] {$1$};
              \node[nd] (P2) at (4,4) {};
              \node[above right=1pt and 2pt of P2] {$1$};

              \draw (N) -- (P1);
              \draw (N) -- (P2);
              \node at (-3.6,5.55) {high card $H$};
              \node at (-3.6,5.15) {probability $= \tfrac{1}{2}$};
              \node at (3.6,5.55) {low card $L$};
              \node at (3.6,5.15) {probability $= \tfrac{1}{2}$};

              % Player 2 nodes
              \node[nd] (Q1) at (-2,2.4) {};
              \node[above right=1pt and 2pt of Q1] {$2$};
              \node[nd] (Q2) at (2,2.4) {};
              \node[above left=1pt and 2pt of Q2] {$2$};

              % Terminal payoffs
              \node (F1) at (-6.2,0.8) {$(-2,2)$};
              \node (T1) at (-3.2,0.8) {$(4,-4)$};
              \node (T2) at (-0.8,0.8) {$(2,-2)$};
              \node (T3) at (0.8,0.8) {$(-4,4)$};
              \node (T4) at (3.2,0.8) {$(2,-2)$};
              \node (F2) at (6.2,0.8) {$(-2,2)$};

              \draw (P1) -- node[above left=0pt and 1pt] {$F$} (F1);
              \draw (P1) -- node[above right=0pt and 1pt] {$B$} (Q1);
              \draw (P2) -- node[above left=0pt and 1pt] {$B$} (Q2);
              \draw (P2) -- node[above right=0pt and 1pt] {$F$} (F2);

              \draw (Q1) -- node[above left=0pt and 0pt] {$B$} (T1);
              \draw (Q1) -- node[above right=0pt and 0pt] {$F$} (T2);
              \draw (Q2) -- node[above left=0pt and 0pt] {$B$} (T3);
              \draw (Q2) -- node[above right=0pt and 0pt] {$F$} (T4);

              % Information set
              \draw[dashed] (Q1) -- (Q2);
              \end{tikzpicture}
              }
            </latex-image>
          </image>
        </figure>
      </solution>
    </task>

    <task xml:id="ans-simple-poker-normal-form">
      <title>The Bayesian normal form</title>
      <statement>
        <p>
          Construct the Bayesian normal form of this game.
        </p>
      </statement>
      <solution>
        <tabular row-headers="yes" halign="center" top="minor" bottom="minor" left="minor" right="minor">
          <col halign="left" right="minor" />
          <col right="minor" />
          <col />
          <row header="yes" bottom="minor">
            <cell></cell>
            <cell>Player 2: <m>B</m></cell>
            <cell>Player 2: <m>F</m></cell>
          </row>
          <row bottom="minor">
            <cell>Player 1: <m>BB</m></cell>
            <cell><m>(0, 0)</m></cell>
            <cell><m>(2, -2)</m></cell>
          </row>
          <row bottom="minor">
            <cell>Player 1: <m>BF</m></cell>
            <cell><m>(1, -1)</m></cell>
            <cell><m>(0, 0)</m></cell>
          </row>
          <row bottom="minor">
            <cell>Player 1: <m>FB</m></cell>
            <cell><m>(-3, 3)</m></cell>
            <cell><m>(0, 0)</m></cell>
          </row>
          <row>
            <cell>Player 1: <m>FF</m></cell>
            <cell><m>(-2, 2)</m></cell>
            <cell><m>(-2, 2)</m></cell>
          </row>
        </tabular>
      </solution>
    </task>

    <task xml:id="ans-simple-poker-eliminate">
      <title>Strictly dominated strategies</title>
      <statement>
        <p>
          Show that <m>FB</m> and <m>FF</m> are strictly dominated, say
          what dominates each, and explain what the two strategies have
          in common.
        </p>
      </statement>
      <solution>
        <ul>
          <li>
            <p>
              <m>FB</m> is strictly dominated by <m>BB</m>:
              <m>0 \gt -3</m> and <m>2 \gt 0</m>.
            </p>
          </li>
          <li>
            <p>
              <m>FF</m> is strictly dominated by <m>BF</m>
              (<m>1 \gt -2</m> and <m>0 \gt -2</m>), and also by
              <m>BB</m> (<m>0 \gt -2</m> and <m>2 \gt -2</m>).
            </p>
          </li>
          <li>
            <p>
              Both strategies fold with the high card. Folding always
              gives Player 1 <m>-2</m>, while bidding with the high card
              gives him <m>4</m> or <m>2</m>, so folding the high card is
              never a good idea.
            </p>
          </li>
        </ul>
      </solution>
    </task>

    <task xml:id="ans-simple-poker-no-equilibrium">
      <title>No Bayesian Nash equilibrium</title>
      <statement>
        <p>
          Use the reduced <m>2 \times 2</m> game to explain why there are
          no Bayesian Nash equilibria, and why it is enough to look at the
          smaller game.
        </p>
      </statement>
      <solution>
        <p>
          In the reduced game, the best responses cycle:
        </p>
        <ul>
          <li>
            <p>
              <m>(BB, B)</m>: Player 1 switches to <m>BF</m> (1 beats 0).
            </p>
          </li>
          <li>
            <p>
              <m>(BF, B)</m>: Player 2 switches to <m>F</m> (0 beats -1).
            </p>
          </li>
          <li>
            <p>
              <m>(BF, F)</m>: Player 1 switches to <m>BB</m> (2 beats 0).
            </p>
          </li>
          <li>
            <p>
              <m>(BB, F)</m>: Player 2 switches to <m>B</m> (0 beats -2).
            </p>
          </li>
        </ul>
        <p>
          So no profile of the reduced game is a Nash equilibrium. It is
          enough to look at the reduced game because the eliminated
          strategies were strictly dominated, and by Theorem 3.2 the
          original game and the reduced game have exactly the same Nash
          equilibria.
        </p>
      </solution>
    </task>
  </exercise>

  <!-- ============================================================ -->
  <exercise xml:id="ans-hw-boss-gorilla-2">
    <title>The Travails of Boss Gorilla 2</title>

    <task xml:id="ans-boss-gorilla-2-matrix">
      <title>The Bayesian normal form</title>
      <statement>
        <p>
          Find the Bayesian normal form of the game in terms of <m>p</m>.
        </p>
      </statement>
      <solution>
        <tabular row-headers="yes" halign="center" top="minor" bottom="minor" left="minor" right="minor">
          <col halign="left" right="minor" />
          <col right="minor" />
          <col />
          <row header="yes" bottom="minor">
            <cell></cell>
            <cell>Visiting Gorilla: <m>c</m></cell>
            <cell>Visiting Gorilla: <m>l</m></cell>
          </row>
          <row bottom="minor">
            <cell>Boss Gorilla: <m>f</m></cell>
            <cell><m>(5 - 6p,\ 6p - 1)</m></cell>
            <cell><m>(6, 0)</m></cell>
          </row>
          <row>
            <cell>Boss Gorilla: <m>a</m></cell>
            <cell><m>(3, 3)</m></cell>
            <cell><m>(6, 0)</m></cell>
          </row>
        </tabular>
      </solution>
    </task>

    <task xml:id="ans-boss-gorilla-2-cases">
      <title>Equilibria in three cases</title>
      <statement>
        <p>
          Find the Bayesian Nash equilibria when
          <m>0 \lt p \lt \frac{1}{6}</m>,
          <m>\frac{1}{6} \lt p \lt \frac{1}{3}</m>, and
          <m>\frac{1}{3} \lt p \lt 1</m>, and describe each in a sentence.
        </p>
      </statement>
      <solution>
        <ul>
          <li>
            <p>
              <m>0 \lt p \lt \frac{1}{6}</m>: the only equilibrium is
              <m>(f, l)</m>. Boss Gorilla would fight if challenged, so
              the visitor leaves.
            </p>
          </li>
          <li>
            <p>
              <m>\frac{1}{6} \lt p \lt \frac{1}{3}</m>: the only
              equilibrium is <m>(f, c)</m>. The visitor challenges and
              Boss Gorilla fights.
            </p>
          </li>
          <li>
            <p>
              <m>\frac{1}{3} \lt p \lt 1</m>: the only equilibrium is
              <m>(a, c)</m>. The visitor challenges and Boss Gorilla
              acquiesces.
            </p>
          </li>
        </ul>
      </solution>
    </task>

    <task xml:id="ans-boss-gorilla-2-compare">
      <title>What the visitor's knowledge changes</title>
      <statement>
        <p>
          Speculate: why does the visitor's knowledge make this difference?
        </p>
      </statement>
      <solution>
        <p>
          Answers will vary. Here is one possible explanation.
        </p>
        <p>
          In Section 4.5, the visitor's decision to challenge can depend
          on whether he would win, so being challenged tells Boss Gorilla
          something about who he is facing. If Boss Gorilla fights, Weak
          visitors stay away, so only Tough ones challenge and he should
          acquiesce instead; but if he acquiesces, Weak visitors challenge
          too, and when <m>p \lt \frac{1}{3}</m> he should fight. Neither
          choice is stable. In this version, the visitor can't base his
          decision on whether he is Tough or Weak, so a challenge tells Boss Gorilla
          nothing new. His best response depends only on <m>p</m>, and an
          equilibrium exists for every <m>p</m>.
        </p>
      </solution>
    </task>
  </exercise>

</exercises>
