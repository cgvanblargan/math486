<?xml version="1.0" encoding="UTF-8"?>

<!-- The docinfo block is the analogue to the latex preamble -->
<!-- This is where you can define macros and other book-wide -->
<!-- settings. -->
<docinfo xmlns:xi="http://www.w3.org/2001/XInclude">
  <document-id>deforest-gametheory-math486</document-id>
  <blurb shelf="Math">
    Online notes and reading companion and study guide for Game Theory (Math 486) at Penn State
    University, built around the required textbook "Game Theory in Action" by
    Schecter and Gintis.
  </blurb>

  <!-- macros for defining latex math shortcuts. -->
  <macros> \newcommand{\N}{\mathbb N} \newcommand{\Z}{\mathbb Z} \newcommand{\Q}{\mathbb Q} \newcommand{\R}{\mathbb R} </macros>

  <!-- If you put any latex-image elements you can include preambles -->
  <!-- for those in the next element. -->
  <latex-image-preamble> \usepackage{tikz, pgfplots} \usetikzlibrary{positioning,matrix,arrows} \usetikzlibrary{shapes,decorations,shadows,fadings,patterns} \usetikzlibrary{decorations.markings} </latex-image-preamble>

 <!--
    CONVENTIONS FOR THIS BOOK. See README.md for full notes.
    This book is a reading companion, not a self contained textbook.
    Two reusable custom block types are used throughout:

      1. Reading directive: tells the student what to read and how.
         Built from assemblage (renamed book-wide to "Reading" below).
         Assemblage gives a full bordered box with the title on its own
         line, unlike remark (thin border only, run-in title) or task
         (no box at all by default). This book dedicates assemblage
         exclusively to reading directives.
         (xml:id prefix: "read-")
      2. Reflection: a written, ungraded reflective question.
         Built from task. (xml:id prefix: "reflect-", type="reflection")

    Auto graded "checkpoint" questions use the normal exercise element
    (xml:id prefix: "check-").

    See source/chapters/chapter1/sections/sec-what-is-a-game/page1-what-is-a-game.ptx
    for a fully worked example of all three in context.
  -->
  <rename element="assemblage" xml:lang="en-US">Reading</rename>
</docinfo>
